<div class="card-text font-weight-light">
  <div class="row align-items-start">

    <!-- Photo -->
    {% if data[1].image and data[1].image != '' %}
      <div class="col-md-3 text-center mb-3 mb-md-0">
        <img
          src="{{ data[1].image | relative_url }}"
          alt="{{ data[1].name }}"
          class="img-fluid rounded"
          style="max-width: 170px;"
        >
      </div>
    {% endif %}

    <!-- Information -->
    <div class="{% if data[1].image and data[1].image != '' %}col-md-9{% else %}col-md-12{% endif %}">

      <!-- Name -->
      {% if data[1].name and data[1].name != '' %}
        <h4 class="font-weight-bold mb-1">
          {{ data[1].name }}
        </h4>
      {% endif %}

      <!-- Position -->
      {% if data[1].label and data[1].label != '' %}
        <p class="mb-2">
          {{ data[1].label }}
        </p>
      {% endif %}

      <!-- Profiles -->
      {% if data[1].profiles %}
        <div class="mb-3">
          {% for profile in data[1].profiles %}

            {% if profile.network == "LinkedIn" %}
              <a
                href="{{ profile.url }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                title="LinkedIn"
                style="font-size: 1.6rem; margin-right: 0.8rem; text-decoration: none;"
              >
                <i class="fa-brands fa-linkedin"></i>
              </a>

            {% elsif profile.network == "Google Scholar" %}
              <a
                href="{{ profile.url }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Google Scholar"
                title="Google Scholar"
                style="font-size: 1.6rem; margin-right: 0.8rem; text-decoration: none;"
              >
                <i class="ai ai-google-scholar"></i>
              </a>
            {% endif %}

          {% endfor %}
        </div>
      {% endif %}

      <!-- Contact -->
      <div style="line-height: 1.9;">

        {% if data[1].email and data[1].email != '' %}
          <div>
            <i class="fa-solid fa-envelope" style="width: 25px;"></i>
            <a href="mailto:{{ data[1].email }}">
              {{ data[1].email }}
            </a>
          </div>
        {% endif %}

        {% if data[1].url and data[1].url != '' %}
          <div>
            <i class="fa-solid fa-globe" style="width: 25px;"></i>
            <a href="{{ data[1].url }}" target="_blank" rel="noopener noreferrer">
              {{ data[1].url }}
            </a>
          </div>
        {% endif %}

        {% if data[1].location and data[1].location.region %}
          <div>
            <i class="fa-solid fa-location-dot" style="width: 25px;"></i>
            {{ data[1].location.region }}
          </div>
        {% endif %}

      </div>

      <!-- Summary -->
      {% if data[1].summary and data[1].summary != '' %}
        <p class="mt-3 mb-0">
          {{ data[1].summary }}
        </p>
      {% endif %}

    </div>
  </div>
</div>