{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>

  <div class="d-flex align-items-center">
    <input
      type="text"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input flex-grow-1"
      placeholder="Type to filter"
    >

    <div class="d-flex align-items-center ml-3">
      <a href="https://scholar.google.com/citations?user=oTu1zfMAAAAJ&hl=fr" target="_blank">
        <i class="ai ai-google-scholar"></i>
      </a>

      <a href="https://dblp.org/pid/319/4703.html" target="_blank" class="ml-2">
        <i class="ai ai-dblp"></i>
      </a>

      <a href="https://orcid.org/0000-0003-2918-1901" target="_blank" class="ml-2">
        <i class="ai ai-orcid"></i>
      </a>
    </div>
  </div>
{% endif %}