{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>

  <div class="d-flex align-items-center gap-3 mb-3">
    <input
      type="text"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input flex-grow-1"
      placeholder="Type to filter"
    >

    <div class="d-flex align-items-center gap-2">
      <a href="https://scholar.google.com/citations?user=oTu1zfMAAAAJ&hl=fr"
         target="_blank"
         rel="noopener noreferrer"
         aria-label="Google Scholar"
         title="Google Scholar">
        <i class="ai ai-google-scholar ai-lg"></i>
      </a>

      <a href="https://dblp.org/pid/319/4703.html"
         target="_blank"
         rel="noopener noreferrer"
         aria-label="DBLP"
         title="DBLP">
        <i class="ai ai-dblp ai-lg"></i>
      </a>

      <a href="https://orcid.org/0000-0003-2918-1901"
         target="_blank"
         rel="noopener noreferrer"
         aria-label="ORCID"
         title="ORCID">
        <i class="ai ai-orcid ai-lg"></i>
      </a>
    </div>
  </div>
{% endif %}